{
  "commands": [
    "cat > /etc/cron.d/s3-log-backup <<'CRON'",
    "# Project 19: back up server logs to S3 every 5 minutes",
    "SHELL=/bin/bash",
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin",
    "*/5 * * * * root /usr/local/bin/s3-log-backup.sh >> /var/log/s3-backup.log 2>&1",
    "CRON",
    "chmod 644 /etc/cron.d/s3-log-backup",
    "systemctl restart crond",
    "echo '--- /etc/cron.d/s3-log-backup ---'",
    "cat /etc/cron.d/s3-log-backup",
    "echo '--- crond ---'",
    "systemctl is-active crond"
  ]
}
