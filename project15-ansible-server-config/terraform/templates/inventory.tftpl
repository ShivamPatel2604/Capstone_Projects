[webservers]
%{ for i, node in nodes ~}
web${i + 1} ansible_host=${node.id} ansible_aws_ssm_instance_id=${node.id} public_ip=${node.public_ip}
%{ endfor ~}

[webservers:vars]
ansible_connection=amazon.aws.aws_ssm
ansible_aws_ssm_region=${region}
ansible_aws_ssm_bucket_name=${bucket}
ansible_aws_ssm_bucket_endpoint_url=https://s3.${region}.amazonaws.com
ansible_aws_ssm_s3_addressing_style=virtual
ansible_python_interpreter=/usr/bin/python3
